      ],
      "text/latex": [
       "$5.749103484873778\\times 10^{-37}\\ \\mathrm{kelvin} \\cdot \\mathrm{kilogram} \\cdot \\mathrm{meter}$"
      ],
      "text/plain": [
       "<Quantity(5.74910348e-37, 'kilogram * meter * kelvin')>"
      ]
     },
     "execution_count": 34,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "T_c.to_base_units()"
   ]
