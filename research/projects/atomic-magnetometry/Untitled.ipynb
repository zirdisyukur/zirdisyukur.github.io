   "source": [
    "import numpy as np\n",
    "from pint import UnitRegistry \n",
    "ureg = UnitRegistry()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "7a319081-ba85-45bc-907c-a2aaaaac68ad",
   "metadata": {},
   "outputs": [],
   "source": [
    "n = 100000\n",
    "m = 10*ureg.um\n",
    "h = ureg.hbar\n",
    "kb = ureg.boltzmann_constant"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "71f82824-a6c8-4fdc-84f2-38fd6c941df0",
   "metadata": {},
   "outputs": [],
   "source": [
    "T_c  = (2*np.pi * h**2 / m) * (n/2.612)**(2/3)/kb"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "9e938e4f-52d2-430a-a8e0-426b616f2e80",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/html": [
